{
  "expo": {
    "name": "Radio Christian International",
    "slug": "radio-ci",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#9B5DE5"
    },
    "ios": {
      "supportsTablet": true,
      "backgroundColor": "#9B5DE5",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#9B5DE5"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "INTERNET",
        "FOREGROUND_SERVICE",
        "WAKE_LOCK",
        "INTERNET",
        "FOREGROUND_SERVICE",
        "WAKE_LOCK"
      ],
      "package": "com.anderchaco.radioci"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
